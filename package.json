{
  "name": "eointraynor",
  "version": "2.2.0",
  "description": "My Digital Business Card",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EoinTraynor/npm-business-card.git"
  },
  "homepage": "https://github.com/EoinTraynor/npm-business-card",
  "bugs": {
    "url": "https://github.com/EoinTraynor/npm-business-card/issues"
  },
  "main": "dist/index.js",
  "bin": {
    "eointraynor": "dist/index.js",
    "info": "dist/index.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "type": "module",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/index.js",
    "record": "python3 scripts/record.py && agg --theme dracula docs/assets/demo.cast docs/assets/npx-eointraynor.gif",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "npm business card",
    "npx business card",
    "business card",
    "cli"
  ],
  "author": {
    "name": "Eoin Traynor",
    "url": "https://eointraynor.com"
  },
  "license": "ISC",
  "devDependencies": {
    "@inquirer/prompts": "^8.7.2",
    "@types/node": "^22.20.2",
    "boxen": "^8.0.1",
    "chalk": "^6.0.0",
    "open": "^11.0.4",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2"
  }
}
